 "html": "<div class=\"print-format\" style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #111111; max-width: 800px; margin: 0 auto; box-sizing: border-box; border: 2px solid #111111; height: 990px; max-height: 990px; position: relative; background: #ffffff; overflow: hidden; page-break-after: avoid; page-break-inside: avoid;\">\n    \n    <!-- Top Header Zone -->\n    <div style=\"height: 120px; box-sizing: border-box; padding: 15px 20px 10px 20px; border-bottom: 2px solid #111111; background-color: #fcfcfc; text-align: center;\">\n        <!-- Full Width Header Logo -->\n        <div style=\"width: 100%; margin-bottom: 8px;\">\n            <img src=\"/files/DAPL_full_logo.png\" alt=\"Company Logo\" style=\"width: 100%; max-height: 65px; object-fit: contain; display: block; margin: 0 auto;\">\n        </div>\n    </div>\n\n    <!-- Document Title -->\n    <div style=\"font-size: 15px; padding: 10px 15px 5px 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #111111; text-align: center;\">\n        Purchase Requisition\n    </div>\n\n    <!-- Line below Purchase Requisition -->\n    <div style=\"border-top: 1px solid #111111; margin-top: 6px;\"></div>\n\n    <!-- Center Content Zone (Reduced side padding to give more breathing room) -->\n    <div style=\"height: 710px; box-sizing: border-box; padding: 15px 12px; overflow: hidden;\">\n        \n        <!-- Requisition Metadata Box -->\n        <table style=\"width: 100%; margin-bottom: 18px; font-size: 13px; border-collapse: collapse; background-color: #f8f9fa; border: 1px solid #dcdcdc; border-radius: 4px;\">\n            <tr>\n                <td style=\"width: 15%; font-weight: 700; padding: 10px 15px; color: #333333;\">Req No:</td>\n                <td style=\"width: 35%; padding: 10px 5px; color: #111111; font-weight: 600;\">{{ doc.purchase_requisition_no }}</td>\n                <td style=\"width: 15%; font-weight: 700; padding: 10px 15px; text-align: right; color: #333333;\">Date:</td>\n                <td style=\"width: 35%; padding: 10px 15px 10px 5px; text-align: right; color: #111111; font-weight: 600;\">{{ doc.get_formatted('date') if doc.date else '' }}</td>\n            </tr>\n        </table>\n\n        <!-- Items Child Table -->\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 12.5px;\">\n            <thead>\n                <tr style=\"background-color: #e9ecef; color: #111111; border-top: 2px solid #111111; border-bottom: 2px solid #111111;\">\n                    <th style=\"padding: 9px 6px; text-align: center; border: 1px solid #111111; width: 5%; font-weight: 700;\">S.No</th>\n                    <th style=\"padding: 9px 8px; text-align: center; border: 1px solid #111111; width: 26%; font-weight: 700;\">Item</th>\n                    <th style=\"padding: 9px 6px; text-align: center; border: 1px solid #111111; width: 11%; font-weight: 700;\">Req Qty</th>\n                    <th style=\"padding: 9px 6px; text-align: center; border: 1px solid #111111; width: 11%; font-weight: 700;\">Stock</th>\n                    <th style=\"padding: 9px 8px; text-align: center; border: 1px solid #111111; width: 10%; font-weight: 700;\">UOM</th>\n                    <th style=\"padding: 9px 8px; text-align: center; border: 1px solid #111111; width: 15%; font-weight: 700;\">Job No</th>\n                    <th style=\"padding: 9px 8px; text-align: center; border: 1px solid #111111; width: 22%; font-weight: 700;\">Remark</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.items %}\n                <tr>\n                    <td style=\"padding: 8px 6px; border: 1px solid #111111; text-align: center; color: #111111;\">{{ loop.index }}</td>\n                    <td style=\"padding: 8px 8px; border: 1px solid #111111; text-align: left; color: #111111;\">{{ row.item }}</td>\n                    <td style=\"padding: 8px 6px; border: 1px solid #111111; text-align: center; color: #111111;\">{{ row.required_qty }}</td>\n                    <td style=\"padding: 8px 6px; border: 1px solid #111111; text-align: center; color: #111111;\">{{ row.stock_in_hand }}</td>\n                    <td style=\"padding: 8px 8px; border: 1px solid #111111; text-align: center; color: #111111;\">{{ row.uom or '' }}</td>\n                    <td style=\"padding: 8px 8px; border: 1px solid #111111; text-align: left; color: #111111;\">{{ row.job_no or '' }}</td>\n                    <td style=\"padding: 8px 8px; border: 1px solid #111111; text-align: left; color: #111111;\">{{ row.remark or '' }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n\n    </div>\n\n    <!-- Bottom Footer Zone -->\n    <div style=\"height: 120px; box-sizing: border-box; padding: 15px 30px; position: absolute; bottom: 0; left: 0; right: 0; background: #ffffff;\">\n        <table style=\"width: 100%; font-size: 13px; border-collapse: collapse;\">\n            <tr>\n                <td style=\"width: 50%; text-align: left; vertical-align: top;\">\n                    <div style=\"display: inline-block;\">\n                        <span style=\"font-weight: 700; color: #333333; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;\">Prepared By</span><br>\n                        <span style=\"font-size: 14px; font-weight: 600; color: #111111; display: inline-block; margin-top: 4px;\">{{ doc.prepared_by or '' }}</span>\n                    </div>\n                </td>\n                <td style=\"width: 50%; text-align: right; vertical-align: top;\">\n                    <div style=\"display: inline-block;\">\n                        <span style=\"font-weight: 700; color: #333333; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;\">Approved By</span><br>\n                        <span style=\"font-size: 14px; font-weight: 600; color: #111111; display: inline-block; margin-top: 4px;\">{{ doc.approved_by or '' }}</span>\n                    </div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n</div>",
